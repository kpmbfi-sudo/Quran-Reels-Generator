# =================================================================
# 📖 إعدادات متغيرات البيئة - Quran Reels Generator
# Environment Variables Configuration
# =================================================================
# قم بنسخ هذا الملف وتسميته .env ثم ضع قيم المفاتيح الخاصة بك
# Copy this file to .env and fill in your own API keys & credentials
# =================================================================

# -----------------------------------------------------------------
# 1️⃣ Pexels API Key (مجاني لجلب خلفيات الفيديو الطبيعية النقية)
# Free API key from https://www.pexels.com/api/
# يُستخدم في المحرك الموحّد (الفيديوهات الطويلة + الريلز) تلقائياً
# -----------------------------------------------------------------
PEXELS_API_KEY=your_pexels_api_key_here

# -----------------------------------------------------------------
# 2️⃣ YouTube OAuth للفيديوهات القصيرة (Shorts/Reels)
#    (مطلوب للـ workflow اليومي للريلز)
# YouTube API credentials from Google Cloud Console & setup_youtube.py
# -----------------------------------------------------------------
YOUTUBE_CLIENT_ID=your_google_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# -----------------------------------------------------------------
# 3️⃣ (اختياري) مشروع Google منفصل للفيديوهات الطويلة
#    Dual-project: فيديو طويل يومي بمشروع منفصل (حصة مستقلة)
#    إذا تركتها فارغة، سيُستخدم نفس مشروع YOUTUBE_* أعلاه.
# Optional second Google project for the daily long full-surah video
# -----------------------------------------------------------------
LONG_YOUTUBE_CLIENT_ID=
LONG_YOUTUBE_CLIENT_SECRET=
LONG_YOUTUBE_REFRESH_TOKEN=

# -----------------------------------------------------------------
# 4️⃣ (اختياري) إشعارات Telegram (تنبيهات النجاح والفشل)
#    أنشئ بوت من @BotFather، أرسل له رسالة، ثم افتح:
#    https://api.telegram.org/bot<TOKEN>/getUpdates لنسخ chat id
# Optional Telegram notifications (silently skipped if unset)
# -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
