# =================================================================
# 📖 إعدادات متغيرات البيئة - Quran Reels Generator
# Environment Variables Configuration
# =================================================================
# قم بنسخ هذا الملف وتسميته .env ثم ضع قيم المفاتيح الخاصة بك
# Copy this file to .env and fill in your own API keys & credentials
# =================================================================

# -----------------------------------------------------------------
# 1️⃣ Pexels API Key (مجاني لجلب خلفيات الفيديو الطبيعية)
# Free API key from https://www.pexels.com/api/
# -----------------------------------------------------------------
PEXELS_API_KEY=your_pexels_api_key_here

# -----------------------------------------------------------------
# 2️⃣ YouTube OAuth Credentials (للرفع التلقائي على يوتيوب)
# YouTube API credentials from Google Cloud Console & setup_youtube.py
# -----------------------------------------------------------------
YOUTUBE_CLIENT_ID=your_google_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here
